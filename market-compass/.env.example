# All optional. The app works with real data without any keys.

# Free key from https://finnhub.io: live tick-by-tick US stock prices + extra news.
FINNHUB_KEY=

# From https://console.anthropic.com: turns on the AI news briefing.
ANTHROPIC_API_KEY=

# If your site is public, set a code so only you can use (and pay for) the AI briefing.
AI_ACCESS_CODE=
