# Optional — Cadence works fully without these (data stays on the device).
# Fill them in to turn on sync across devices, push reminders when the app is
# closed, and the capture webhook for texts/email. See README → Cloud setup.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
