# ── Required for camera scanning (card identification + condition grading) ──
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model / effort used for scans
# SCAN_MODEL=claude-opus-5-5
# SCAN_EFFORT=medium

# ── Strongly recommended once deployed ──
# Anyone who finds your URL could otherwise run up your Anthropic bill.
# Set a passcode here, then enter the same passcode in the app's Settings tab.
APP_PASSCODE=

# ── Optional price sources (the app works without these) ──
# eBay developer keys (free): https://developer.ebay.com → Application Keys (Production)
# Adds live eBay listing prices for the exact card.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# PriceCharting API token (paid subscription): https://www.pricecharting.com/api-documentation
# Adds eBay *sold* averages, including PSA/BGS/CGC graded prices.
PRICECHARTING_TOKEN=

# Pokémon TCG API key (free, optional, raises rate limits): https://dev.pokemontcg.io
POKEMONTCG_API_KEY=
