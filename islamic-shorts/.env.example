# Copy this file to ".env" (setup.bat does it for you) and fill in what you have.
# Everything is optional except: ONE way to write scripts and ONE way to make images.
# Run  python make_video.py --check  to see what is working.

# ---------------------------------------------------------------- script writing
# Free: Google Gemini - create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional paid upgrade (best writing): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional free alternative: https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------- images
# Premium: if the Higgsfield CLI is installed and logged in, it is used automatically
# (npm install -g @higgsfield/cli   then   higgsfield auth login). Uses your credits.
# HIGGSFIELD_IMAGE_MODEL=gpt_image_2
# HIGGSFIELD_IMAGE_ARGS=--quality high
# HIGGSFIELD_CLI=C:\path\to\hf.exe        (only if it is not found automatically)

# Free: Cloudflare Workers AI (about 100 images/day free; also writes scripts)
#   1. sign up at https://dash.cloudflare.com  2. Account ID is on the Workers AI page
#   3. My Profile -> API Tokens -> Create Token -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Pollinations (free starter credits) - https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# Force a provider instead of the automatic order (auto = best available first):
# IMAGE_PROVIDER=auto        # auto | higgsfield | cloudflare | pollinations
# SCRIPT_PROVIDER=auto       # auto | claude | gemini | groq | cloudflare | pollinations
# VOICE_PROVIDER=auto        # auto | elevenlabs | edge | kokoro

# ---------------------------------------------------------------- voice
# Free by default (Microsoft Edge neural voices, no account needed).
# EDGE_VOICE=en-US-ChristopherNeural     # also good: en-US-AndrewNeural, en-GB-RyanNeural
# EDGE_RATE=-6%
# EDGE_PITCH=-2Hz

# Optional paid upgrade: ElevenLabs (used automatically when a key is set)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb   # "Brian"; paste any voice id from your library
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------------------------------------------------------------- look & sound
# STYLE=fresco               # fresco | miniature | cinematic
# CAPTIONS=true
# PARTICLES=true             # drifting golden dust
# FILM_GRAIN=true
# MUSIC=                     # path to a background audio file (leave empty for voice only)
# MUSIC_VOLUME=0.10
# OUTPUT_DIR=output

# ---------------------------------------------------------------- Facebook auto-posting
# Optional. See README -> "Auto-posting to Facebook".
FB_PAGE_ID=
FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v24.0
